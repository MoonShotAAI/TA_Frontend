# ==========================================
# TA_Frontend .gitignore
# ==========================================

# 1. Databases (Local DB files if created)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# 2. Local Storage & Uploaded/Extracted Student Files
storage/
storage/*
!storage/**/.gitkeep
test_dataset_docx/
test_submissions_*.zip
*.zip

# 3. Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# 4. Next.js & Build Outputs
/.next/
/out/
/build
/dist
*.tsbuildinfo
next-env.d.ts

# 5. Testing & Coverage
/coverage

# 6. Environment Variables
.env
.env*.local
.env*
!.env.example

# 7. Vercel
.vercel

# 8. Logs & Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# 9. IDE & OS Metadata
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*.pem
